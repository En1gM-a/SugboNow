PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Anon (publishable) key — the same value as VITE_SUPABASE_ANON_KEY in frontend/.env.
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# A job whose key is blank is skipped.
TOMTOM_API_KEY=
GNEWS_API_KEY=
WEATHER_API_KEY=
AI_API_KEY=

# Public RSS feeds, no keys. SunStar's Cebu-only collection (cebu.rss) is
# empty, so the local-news feed is used and filtered to Cebu stories.
SUNSTAR_RSS_URL=https://www.sunstar.com.ph/api/v1/collections/local-news.rss
CDN_RSS_URL=https://cebudailynews.inquirer.net/category/latest-news/feed

CRON_ENABLED=false
TZ=Asia/Manila

# Sign-in-triggered Facebook check of official LGU pages (needs Chromium:
# `npx playwright install chromium`). Set to false to serve saved posts only.
FB_SCRAPE_ENABLED=true
FB_REFRESH_INTERVAL_MINUTES=10
