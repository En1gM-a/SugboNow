PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

TOMTOM_API_KEY=
GNEWS_API_KEY=
AI_API_KEY=
WEATHER_API_KEY=

# SunStar has no API key — this is a public RSS feed, not an authenticated API.
SUNSTAR_RSS_URL=https://www.sunstar.com.ph/api/v1/collections/cebu.rss

CRON_ENABLED=false
TZ=Asia/Manila

# Sign-in-triggered Facebook check of official LGU pages (needs Chromium:
# `npx playwright install chromium`). Set to false to serve saved posts only.
FB_SCRAPE_ENABLED=true
FB_REFRESH_INTERVAL_MINUTES=10
